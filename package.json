{
  "name": "crystal-boot",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "parity": "python3 scripts/parity.py",
    "build": "vite build --config web/vite.config.ts",
    "dev": "npm run build && wrangler dev --test-scheduled",
    "dev:web": "vite --config web/vite.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply crystal-boot --local",
    "db:migrate:remote": "wrangler d1 migrations apply crystal-boot --remote",
    "deploy": "npm run build && wrangler deploy",
    "demo:seed": "esbuild scripts/demo-seed.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.wrangler/demo-seed.mjs && node .wrangler/demo-seed.mjs && wrangler d1 execute crystal-boot --local --file .wrangler/demo-seed.sql"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1",
    "wrangler": "^4.141.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
